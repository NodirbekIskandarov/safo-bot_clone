# --- required -------------------------------------------------------------
# Platform bot token from @BotFather (this is the bot users talk to)
PLATFORM_BOT_TOKEN=

# 32-byte base64 key used to encrypt tenant bot tokens.
# Generate with: npm run keygen
ENCRYPTION_KEY=

# --- optional -------------------------------------------------------------
DATABASE_URL="file:../data/app.db"

# Telegram user IDs of platform admins (comma separated). Get yours from @userinfobot
PLATFORM_ADMIN_IDS=

# Max bots a single owner may create
MAX_BOTS_PER_OWNER=5

# Broadcast throughput (Telegram hard limit is ~30/s)
BROADCAST_RATE_PER_SEC=20

LOG_LEVEL=info

# --- Mini App (ixtiyoriy) ------------------------------------------------
# HTTPS manzil. Bo'sh bo'lsa ilova tugmalari umuman ko'rsatilmaydi.
WEB_APP_URL=
WEB_PORT=3100
WEB_HOST=127.0.0.1
